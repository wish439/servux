+	modImplementation "maven.modrinth:tweakeroo:${getLatestModVersion('tweakeroo', mcVersion, loader)}"
+	modLocalRuntime  "maven.modrinth:tweakeroo:${getLatestModVersion('tweakeroo', mcVersion, loader)}"
+	modImplementation "maven.modrinth:malilib:${getLatestModVersion('malilib', mcVersion, loader)}"
+	modLocalRuntime  "maven.modrinth:malilib:${getLatestModVersion('malilib', mcVersion, loader)}"
+	modImplementation "maven.modrinth:litematica:${getLatestModVersion('litematica', mcVersion, loader)}"
+	modLocalRuntime  "maven.modrinth:litematica:${getLatestModVersion('litematica', mcVersion, loader)}"
 
+	modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_api_version}"
+	include api("me.fallenbreath:conditional-mixin-fabric:${project.conditional_mixin_version}")
 	// Lucko Permissions API
 	modImplementation include("me.lucko:fabric-permissions-api:${project.fabric_permissions_api_version}")
 //	modRuntimeOnly 'me.fallenbreath:mixin-auditor:0.1.0'
