diff --git a/src/main/java/fi/dy/masa/servux/dataproviders/HudDataProvider.java b/src/main/java/fi/dy/masa/servux/dataproviders/HudDataProvider.java
--- a/src/main/java/fi/dy/masa/servux/dataproviders/HudDataProvider.java	(revision 3f2db30d486a06b157c6908ff7f3575b29fe0483)
+++ b/src/main/java/fi/dy/masa/servux/dataproviders/HudDataProvider.java	(revision ddb97d800ec1471d0708ee6c354bdfe5e0e6ac81)
@@ -2,6 +2,8 @@
 
 import java.util.*;
 import javax.annotation.Nullable;
+
+import net.fabricmc.loader.api.FabricLoader;
 import org.jspecify.annotations.NonNull;
 
 import com.mojang.serialization.DataResult;
@@ -131,6 +133,13 @@
 	@Override
 	public void registerHandler()
 	{
+		if (FabricLoader.getInstance().isModLoaded("minihud")) {
+			ServerPlayHandler.getInstance().registerServerPlayHandler(HANDLER);
+			this.setRegistered(true);
+			HANDLER.setPlayRegistered(ServuxHudHandler.CHANNEL_ID);
+			HANDLER.registerPlayReceiver(ServuxHudPacket.Payload.ID, HANDLER::receivePlayPayload);
+			return;
+		}
 		ServerPlayHandler.getInstance().registerServerPlayHandler(HANDLER);
 
 		if (!this.isRegistered())
